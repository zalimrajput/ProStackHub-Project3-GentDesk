# Backend configuration template — copy to .env and fill in real values.
# NEVER put real credentials in this file.

# --- Database ---
# PostgreSQL (production), e.g. Supabase:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# SQLite (zero-config local dev):
# DATABASE_URL=sqlite:///./gentdesk.db

# --- LLM (AI) ---
# Provider: auto | gemini | openai | mock
# auto = use whichever key you provide (Gemini first, then OpenAI)
# mock = deterministic offline responses, no key needed
LLM_PROVIDER=auto
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Web Search ---
# Backend: auto | duckduckgo | serper | tavily | mock
# duckduckgo needs no API key. serper requires SERPER_API_KEY. tavily requires TAVILY_API_KEY.
SEARCH_BACKEND=auto
SERPER_API_KEY=your_serper_api_key_here
TAVILY_API_KEY=

# --- Orchestrator limits (prevent infinite runs) ---
RELEVANCE_THRESHOLD=0.5
MAX_RETRIES=3
MAX_ATTEMPTS_PER_TASK=3
MAX_QUERIES_PER_TASK=3
MAX_TASKS=10
MAX_TOTAL_SEARCHES=40
MAX_EVIDENCE=30
SEARCH_RESULTS_PER_QUERY=8
GAP_RESEARCH_ENABLED=true

# --- Server ---
CORS_ORIGINS=http://localhost:3000
LLM_TIMEOUT=60
